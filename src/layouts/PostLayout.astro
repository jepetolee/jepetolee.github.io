---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Callout from '../components/Callout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Giscus from '../components/Giscus.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import { readingTime, postUrl, getSeries, slugOf } from '../utils/posts';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { localizedPath } from '../i18n/utils';
import { useTranslations } from '../i18n/ui';

interface Props {
  post: CollectionEntry<'posts'>;
  headings: MarkdownHeading[];
  locale?: Locale;
}

const { post, headings, locale = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(locale);
const { title, date, tags, category, tldr, prerequisites, series } = post.data;
const minutes = readingTime(post.body);

let seriesPosts: CollectionEntry<'posts'>[] = [];
if (series) {
  const all = await getSeries(locale);
  seriesPosts = all.get(series) ?? [];
}
const related = seriesPosts.filter((p) => slugOf(p) !== slugOf(post)).slice(0, 3);
---

<BaseLayout title={title} description={post.data.description} article={true} narrow={true} locale={locale}>
  <article class="post-article" data-pagefind-body>
    <header class="post-article__header">
      <span class="kind-badge kind-badge--post">POST</span>
      <h1 class="post-article__title">{title}</h1>
      <div class="post-article__meta">
        <FormattedDate date={date} locale={locale} />
        <span aria-hidden="true">·</span>
        <span class="post-article__reading"><Icon name="clock" /> {t('post.readingTime', { count: minutes })}</span>
        {category && <><span aria-hidden="true">·</span><span>{category}</span></>}
      </div>
      {tags.length > 0 && (
        <div class="post-article__tags">
          {tags.map((tag) => (
            <a class="post-tag" href={localizedPath(locale, `tags/${encodeURIComponent(tag)}`)}>{tag}</a>
          ))}
        </div>
      )}
    </header>

    {tldr && tldr.length > 0 && (
      <Callout type="tldr" locale={locale}>
        <ul>{tldr.map((item) => <li>{item}</li>)}</ul>
      </Callout>
    )}

    {prerequisites && prerequisites.length > 0 && (
      <Callout type="prereq" locale={locale}>
        <ul>{prerequisites.map((item) => <li set:html={item} />)}</ul>
      </Callout>
    )}

    <TableOfContents headings={headings} locale={locale} />

    <div class="post-article__body prose">
      <slot />
    </div>
  </article>

  {related.length > 0 && (
    <section class="series-related">
      <h2 class="section-title">{t('post.seriesOther', { series: series ?? '' })}</h2>
      {related.map((p) => (
        <PostCard
          url={postUrl(locale, slugOf(p))}
          title={p.data.title}
          date={p.data.date}
          tags={p.data.tags}
          description={p.data.description}
          category={p.data.category}
          locale={locale}
        />
      ))}
    </section>
  )}

  <Giscus locale={locale} />
</BaseLayout>

<style>
  .post-article { max-width: var(--max-width); margin: 0 auto; }
  .post-article__header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .kind-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    margin-bottom: 0.6rem;
  }
  .kind-badge--post { color: var(--color-post-text); background: var(--color-post-bg); }
  .post-article__title {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
    line-height: 1.25;
  }
  @media (min-width: 640px) {
    .post-article__title { font-size: 2.25rem; }
  }
  .post-article__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }
  .post-article__reading {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .post-article__reading :global(svg) { width: 0.875rem; height: 0.875rem; }
  .post-article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .series-related {
    max-width: var(--max-width);
    margin: 3rem auto 0;
  }
</style>
