---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Callout from '../components/Callout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Giscus from '../components/Giscus.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import { readingTime, postUrl, getSeries } from '../utils/posts';

interface Props {
  post: CollectionEntry<'posts'>;
  headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const { title, date, tags, category, tldr, prerequisites, series } = post.data;
const minutes = readingTime(post.body);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

let seriesPosts: CollectionEntry<'posts'>[] = [];
if (series) {
  const all = await getSeries();
  seriesPosts = all.get(series) ?? [];
}
const related = seriesPosts.filter((p) => p.id !== post.id).slice(0, 3);
---

<BaseLayout title={title} description={post.data.description} article={true} narrow={true}>
  <article class="post-article" data-pagefind-body>
    <header class="post-article__header">
      <h1 class="post-article__title">{title}</h1>
      <div class="post-article__meta">
        <FormattedDate date={date} />
        <span aria-hidden="true">·</span>
        <span class="post-article__reading"><Icon name="clock" /> {minutes}분 읽기</span>
        {category && <><span aria-hidden="true">·</span><span>{category}</span></>}
      </div>
      {tags.length > 0 && (
        <div class="post-article__tags">
          {tags.map((tag) => (
            <a class="post-tag" href={`${base}/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
          ))}
        </div>
      )}
    </header>

    {tldr && tldr.length > 0 && (
      <Callout type="tldr">
        <ul>{tldr.map((item) => <li>{item}</li>)}</ul>
      </Callout>
    )}

    {prerequisites && prerequisites.length > 0 && (
      <Callout type="prereq">
        <ul>{prerequisites.map((item) => <li set:html={item} />)}</ul>
      </Callout>
    )}

    <TableOfContents headings={headings} />

    <div class="post-article__body prose">
      <slot />
    </div>
  </article>

  {related.length > 0 && (
    <section class="series-related">
      <h2 class="section-title">{series} 시리즈의 다른 글</h2>
      {related.map((p) => (
        <PostCard
          url={postUrl(p.id)}
          title={p.data.title}
          date={p.data.date}
          tags={p.data.tags}
          description={p.data.description}
          category={p.data.category}
        />
      ))}
    </section>
  )}

  <Giscus />
</BaseLayout>

<style>
  .post-article { max-width: var(--max-width); margin: 0 auto; }
  .post-article__header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .post-article__title {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
    line-height: 1.25;
  }
  @media (min-width: 640px) {
    .post-article__title { font-size: 2.25rem; }
  }
  .post-article__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }
  .post-article__reading {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .post-article__reading :global(svg) { width: 0.875rem; height: 0.875rem; }
  .post-article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .series-related {
    max-width: var(--max-width);
    margin: 3rem auto 0;
  }
</style>
