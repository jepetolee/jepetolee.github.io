---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import Icon from '../components/Icon.astro';
import { DEFAULT_LOCALE, LOCALE_META, type Locale } from '../i18n/config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  narrow?: boolean;
  locale?: Locale;
}

const { title, description, image, article = false, narrow = false, locale = DEFAULT_LOCALE } =
  Astro.props;
const meta = LOCALE_META[locale];
---

<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir}>
  <head>
    <BaseHead title={title} description={description} image={image} article={article} locale={locale} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header locale={locale} />
    <main class="site-main" id="main">
      <div class:list={['container', { 'container--narrow': narrow }]}>
        <slot />
      </div>
    </main>
    <Footer />

    <button type="button" class="scroll-top" id="scroll-top" aria-label="Scroll to top">
      <Icon name="arrow-up" />
    </button>

    <Analytics />

    <style>
      .scroll-top {
        position: fixed;
        right: 1.5rem;
        bottom: 1.5rem;
        z-index: 100;
        display: none;
        align-items: center;
        justify-content: center;
        width: 2.75rem;
        height: 2.75rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 50%;
        box-shadow: var(--shadow-lg);
        color: var(--color-text);
        transition: transform var(--transition), color var(--transition);
      }
      .scroll-top.is-visible { display: flex; }
      .scroll-top:hover { transform: translateY(-2px); color: var(--color-accent); }
      .scroll-top :global(svg) { width: 1.25rem; height: 1.25rem; }
    </style>

    <script>
      const scrollTop = document.getElementById('scroll-top');
      if (scrollTop) {
        window.addEventListener('scroll', () => {
          scrollTop.classList.toggle('is-visible', window.scrollY > 500);
        });
        scrollTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      }
    </script>
  </body>
</html>
