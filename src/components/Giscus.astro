---
import { SITE } from '../config';
import { DEFAULT_LOCALE, LOCALE_META, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(locale);
const { giscus } = SITE;
const enabled = giscus.repoId && giscus.categoryId;
const giscusLang = LOCALE_META[locale].giscus;
---
{enabled ? (
  <section class="comments">
    <h2 class="comments__title">{t('comments.title')}</h2>
    <script
      src="https://giscus.app/client.js"
      data-repo={giscus.repo}
      data-repo-id={giscus.repoId}
      data-category={giscus.category}
      data-category-id={giscus.categoryId}
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="bottom"
      data-theme="preferred_color_scheme"
      data-lang={giscusLang}
      crossorigin="anonymous"
      async
    ></script>
  </section>
) : (
  <section class="comments">
    <h2 class="comments__title">{t('comments.title')}</h2>
    <p class="comments__hint">
      댓글을 활성화하려면 GitHub 저장소에 Discussions를 켜고 giscus 앱을 설치한 뒤
      <code>src/config.ts</code>의 <code>giscus.repoId</code>와 <code>categoryId</code>를 채워주세요.
    </p>
  </section>
)}

<style>
  .comments {
    max-width: var(--max-width);
    margin: 3rem auto 0;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .comments__title { font-size: 1.125rem; margin-bottom: 1rem; }
  .comments__hint {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  .comments__hint code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--color-code-bg);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
</style>
