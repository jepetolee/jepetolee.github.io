---
interface Props {
  type?: 'tldr' | 'prereq' | 'pitfall' | 'note';
  title?: string;
}
const { type = 'note', title } = Astro.props;
const labels: Record<string, string> = {
  tldr: 'TL;DR',
  prereq: '사전 지식',
  pitfall: '주의 / 삽질 노트',
  note: 'Note',
};
const heading = title ?? labels[type];
---
<aside class:list={['callout', `callout--${type}`]}>
  <p class="callout__label">{heading}</p>
  <div class="callout__body"><slot /></div>
</aside>

<style>
  .callout {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    border-left: 4px solid var(--color-accent);
    background: var(--color-code-bg);
  }
  .callout__label {
    margin: 0 0 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
  }
  .callout__body { font-size: 0.9375rem; }
  .callout__body :global(p) { margin: 0.25rem 0; }
  .callout__body :global(ul) { margin: 0.25rem 0; padding-left: 1.25rem; }
  .callout--pitfall { border-left-color: #e11d48; }
  .callout--pitfall .callout__label { color: #e11d48; }
  .callout--prereq { border-left-color: #d97706; }
  .callout--prereq .callout__label { color: #d97706; }
  .callout--tldr { border-left-color: #059669; }
  .callout--tldr .callout__label { color: #059669; }
</style>
