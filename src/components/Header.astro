---
import Icon from './Icon.astro';
import { SITE, NAV, SOCIAL } from '../config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '') || '/';

function isActive(href: string) {
  if (href === '/') return path === '/';
  return path.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="site-header__brand" href={`${base}/`}>
      <img class="site-header__logo" src={`${base}/logo.png`} alt={SITE.title} width="30" height="30" />
      <span>{SITE.title}</span>
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      {NAV.map((item) => (
        <a class:list={['site-nav__link', { 'is-active': isActive(item.href) }]} href={`${base}${item.href}`}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="site-header__actions">
      <div class="site-header__social">
        <a class="icon-btn" href={SOCIAL.github} aria-label="GitHub"><Icon name="github" /></a>
        <a class="icon-btn" href={SOCIAL.linkedin} aria-label="LinkedIn"><Icon name="linkedin" /></a>
        <a class="icon-btn" href={SOCIAL.email} aria-label="Email"><Icon name="email" /></a>
      </div>
      <button type="button" class="icon-btn" id="theme-toggle" aria-label="Toggle dark mode"><Icon name="moon" /></button>
      <a class="icon-btn" href={`${base}/search/`} aria-label="Search"><Icon name="search" /></a>
      <button type="button" class="icon-btn site-header__menu" id="menu-toggle" aria-label="Open menu" aria-expanded="false"><Icon name="menu" /></button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation">
    {NAV.map((item) => (
      <a class:list={['mobile-nav__link', { 'is-active': isActive(item.href) }]} href={`${base}${item.href}`}>
        {item.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 200;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    gap: 1rem;
  }
  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-text);
    text-decoration: none;
    flex-shrink: 0;
  }
  .site-header__brand:hover { text-decoration: none; }
  .site-header__logo {
    height: 30px;
    width: 30px;
    object-fit: contain;
  }
  /* Black-on-transparent mark flips to white in dark mode */
  :global(:root[data-theme='dark']) .site-header__logo { filter: invert(1); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .site-header__logo { filter: invert(1); }
  }

  .site-nav {
    display: none;
    align-items: center;
    gap: 0.25rem;
  }
  @media (min-width: 880px) {
    .site-nav { display: flex; }
  }
  .site-nav__link {
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    border-radius: var(--radius);
    text-decoration: none;
  }
  .site-nav__link:hover,
  .site-nav__link:focus,
  .site-nav__link.is-active {
    color: var(--color-accent);
    background: var(--color-tag-bg);
    text-decoration: none;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .site-header__social {
    display: none;
    align-items: center;
    gap: 0.25rem;
  }
  @media (min-width: 880px) {
    .site-header__social { display: flex; }
  }
  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-text-muted);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    transition: color var(--transition), border-color var(--transition);
  }
  .icon-btn:hover,
  .icon-btn:focus {
    color: var(--color-accent);
    border-color: var(--color-accent);
    text-decoration: none;
  }
  .icon-btn :global(svg) { width: 1.125rem; height: 1.125rem; }

  .site-header__menu { display: flex; }
  @media (min-width: 880px) {
    .site-header__menu { display: none; }
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    padding: 0.5rem 1.25rem 1rem;
    border-top: 1px solid var(--color-border);
  }
  .mobile-nav.is-open { display: flex; }
  @media (min-width: 880px) {
    .mobile-nav.is-open { display: none; }
  }
  .mobile-nav__link {
    padding: 0.75rem 0;
    font-weight: 500;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
  }
  .mobile-nav__link:hover,
  .mobile-nav__link:focus,
  .mobile-nav__link.is-active {
    color: var(--color-accent);
    text-decoration: none;
  }
</style>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  menuToggle?.addEventListener('click', () => {
    const open = mobileNav?.classList.toggle('is-open');
    menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const next = current === 'dark' ? 'light' : current === 'light' ? 'dark' : prefersDark ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  });
</script>
