---
import { DEFAULT_LOCALE, LOCALE_META, LOCALES } from '../i18n/config';
import { SITE } from '../config';
import '../styles/tokens.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const supported = [...LOCALES];
const options = LOCALES.map((l) => ({ code: l, label: LOCALE_META[l].label, href: `${base}/${l}/` }));
---

<!doctype html>
<html lang={DEFAULT_LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{SITE.title}</title>
    <meta name="description" content={SITE.description} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    {LOCALES.map((l) => (
      <link rel="alternate" hreflang={LOCALE_META[l].htmlLang} href={`${base}/${l}/`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${base}/${DEFAULT_LOCALE}/`} />
    <script is:inline define:vars={{ base, supported }}>
      (function () {
        try {
          const stored = localStorage.getItem('locale');
          let target = stored && supported.includes(stored) ? stored : null;
          if (!target) {
            const navs = (navigator.languages || [navigator.language || 'ko']).map((l) =>
              String(l).toLowerCase(),
            );
            for (const l of navs) {
              const code = l.split('-')[0];
              if (l.startsWith('zh')) { target = 'zh'; break; }
              if (supported.includes(code)) { target = code; break; }
            }
          }
          if (!target) target = 'ko';
          window.location.replace(base + '/' + target + '/');
        } catch (e) {
          window.location.replace(base + '/ko/');
        }
      })();
    </script>
  </head>
  <body>
    <main class="picker">
      <span class="picker__logo" role="img" aria-label={SITE.title}></span>
      <h1 class="picker__title">{SITE.title}</h1>
      <p class="picker__hint">Choose your language · 언어 선택</p>
      <ul class="picker__list">
        {options.map((o) => (
          <li>
            <a
              class="picker__link"
              href={o.href}
              hreflang={LOCALE_META[o.code].htmlLang}
              lang={LOCALE_META[o.code].htmlLang}
              data-locale={o.code}
            >
              {o.label}
            </a>
          </li>
        ))}
      </ul>
    </main>
    <script is:inline>
      document.querySelectorAll('.picker__link').forEach((el) => {
        el.addEventListener('click', () => {
          try {
            localStorage.setItem('locale', el.getAttribute('data-locale'));
          } catch (e) {}
        });
      });
    </script>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--color-bg);
        color: var(--color-text);
        font-family: var(--font-sans);
      }
      .picker { text-align: center; padding: 2rem; }
      .picker__logo {
        display: inline-block;
        width: 4.5rem;
        height: 4.5rem;
        background: var(--color-text);
        mask: url('/logo.png') center / contain no-repeat;
        -webkit-mask: url('/logo.png') center / contain no-repeat;
        margin-bottom: 1rem;
      }
      .picker__title { font-size: 1.6rem; margin: 0 0 0.35rem; }
      .picker__hint { color: var(--color-text-muted); font-size: 0.9rem; margin: 0 0 1.75rem; }
      .picker__list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 0.6rem;
        max-width: 26rem;
      }
      .picker__link {
        display: block;
        padding: 0.75rem 1rem;
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        color: var(--color-text);
        text-decoration: none;
        transition: border-color 0.2s ease, color 0.2s ease;
      }
      .picker__link:hover { border-color: var(--color-accent); color: var(--color-accent); }
    </style>
  </body>
</html>
