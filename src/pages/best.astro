---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, postUrl } from '../utils/posts';

const posts = await getPublishedPosts();

// Curate by category (topic). Falls back to all posts grouped by category.
const byCategory = new Map<string, typeof posts>();
for (const post of posts) {
  const cat = post.data.category ?? '기타';
  const list = byCategory.get(cat) ?? [];
  list.push(post);
  byCategory.set(cat, list);
}
---

<BaseLayout title="Best Articles" description="주제별로 엄선한 추천 글 모음" narrow={true}>
  <h1 class="page-title">Best Articles</h1>
  <p class="page-sub">
    시간순 아카이브가 전체 서가라면, 이 페이지는 주제별로 먼저 추천하는 글들의 책장입니다.
  </p>

  {[...byCategory.entries()].map(([category, list]) => (
    <section class="best-section">
      <h2 class="best-section__title">{category}</h2>
      <ul class="best-list">
        {list.map((post) => (
          <li class="best-item">
            <a class="best-item__link" href={postUrl(post.id)}>{post.data.title}</a>
            {post.data.description && <p class="best-item__desc">{post.data.description}</p>}
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<style>
  .page-title { font-size: 1.75rem; margin-bottom: 0.25rem; }
  .page-sub { color: var(--color-text-muted); font-size: 0.9rem; margin: 0 0 2rem; }
  .best-section { margin-bottom: 2rem; }
  .best-section__title {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
    color: var(--color-accent);
  }
  .best-list { list-style: none; padding: 0; margin: 0; }
  .best-item {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .best-item__link { font-weight: 600; font-size: 1rem; }
  .best-item__desc {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-family: var(--font-serif);
  }
</style>
