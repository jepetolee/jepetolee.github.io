---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SOCIAL } from '../../config';
import { LOCALES } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

export const getStaticPaths = (() =>
  LOCALES.map((locale) => ({ params: { locale }, props: { locale } }))) satisfies GetStaticPaths;

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout title={t('about.title')} description={t('site.description')} narrow={true} locale={locale}>
  <h1 class="page-title">{t('about.title')}</h1>

  <div class="about-meta">
    <p>{t('about.authorLabel')}: 이재석</p>
    <p class="about-meta__label">{t('about.interestsLabel')}</p>
    <p class="about-interests">Machine Learning, Data Science, NeuroScience, Mathematics for Computer Science</p>
    <p>
      {t('about.contactLabel')}:
      <a href={SOCIAL.github}>GitHub</a> ·
      <a href={SOCIAL.linkedin}>LinkedIn</a> ·
      <a href={SOCIAL.email}>Email</a>
    </p>
    <p>{t('about.comments')}</p>
  </div>
</BaseLayout>

<style>
  .page-title { font-size: 1.75rem; margin-bottom: 1.5rem; }
  .about-meta {
    padding: 1.25rem 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }
  .about-meta p { margin: 0.4rem 0; }
  .about-meta__label { font-weight: 600; margin-top: 0.75rem; }
  .about-interests { color: var(--color-accent); font-weight: 500; }
</style>
