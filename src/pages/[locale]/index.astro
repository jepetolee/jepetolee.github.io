---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getSeries, getPapers, postUrl, paperUrl, slugOf } from '../../utils/posts';
import { SITE } from '../../config';
import { LOCALES } from '../../i18n/config';
import { localizedPath } from '../../i18n/utils';
import { useTranslations } from '../../i18n/ui';

export const getStaticPaths = (() =>
  LOCALES.map((locale) => ({ params: { locale }, props: { locale } }))) satisfies GetStaticPaths;

const { locale } = Astro.props;
const t = useTranslations(locale);

const posts = await getPublishedPosts(locale);
const featured = posts.filter((p) => p.data.featured).slice(0, 3);
const recent = posts.slice(0, 5);
const series = await getSeries(locale);
const papers = await getPapers(locale);
const recentPapers = papers.slice(0, 4);
---

<BaseLayout narrow={true} locale={locale}>
  <section class="hero">
    <span class="hero__image" role="img" aria-label={SITE.title}></span>
    <h1 class="hero__title">{SITE.title}</h1>
    <p class="hero__tagline">{t('site.tagline')}</p>
    <p class="hero__intro">{t('site.intro')}</p>
    <div class="hero__actions">
      <a class="btn" href={localizedPath(locale, '/insight/')}>{t('home.ctaBlog')}</a>
      <a class="btn btn--outline" href={localizedPath(locale, '/papers/')}>{t('home.ctaPapers')}</a>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="home-section">
      <h2 class="section-title">{t('home.featured')}</h2>
      <div class="post-list">
        {featured.map((post) => (
          <PostCard
            url={postUrl(locale, slugOf(post))}
            title={post.data.title}
            date={post.data.date}
            tags={post.data.tags}
            description={post.data.description}
            category={post.data.category}
            locale={locale}
          />
        ))}
      </div>
    </section>
  )}

  <section class="home-section">
    <div class="home-section__head">
      <h2 class="section-title section-title--inline">{t('home.recentPosts')}</h2>
      <span class="kind-badge kind-badge--post">POST</span>
    </div>
    <div class="post-list">
      {recent.map((post) => (
        <PostCard
          url={postUrl(locale, slugOf(post))}
          title={post.data.title}
          date={post.data.date}
          tags={post.data.tags}
          description={post.data.description}
          category={post.data.category}
          locale={locale}
        />
      ))}
    </div>
    <div class="home-section__more">
      <a class="btn btn--outline" href={localizedPath(locale, '/insight/')}>{t('home.allPosts')}</a>
    </div>
  </section>

  {recentPapers.length > 0 && (
    <section class="home-section">
      <div class="home-section__head">
        <h2 class="section-title section-title--inline">{t('home.paperReviews')}</h2>
        <span class="kind-badge kind-badge--paper">PAPER</span>
      </div>
      <p class="home-section__desc">{t('home.paperReviewsDesc')}</p>
      <ul class="paper-mini">
        {recentPapers.map((paper) => (
          <li class="paper-mini__item">
            <a class="paper-mini__link" href={paperUrl(locale, slugOf(paper))}>{paper.data.title}</a>
            <span class="paper-mini__meta">
              {[paper.data.category, paper.data.subcategory, paper.data.year]
                .filter(Boolean)
                .join(' · ')}
            </span>
          </li>
        ))}
      </ul>
      <div class="home-section__more">
        <a class="btn btn--outline" href={localizedPath(locale, '/papers/')}>{t('home.allPapers')}</a>
      </div>
    </section>
  )}

  {series.size > 0 && (
    <section class="home-section">
      <h2 class="section-title">{t('home.series')}</h2>
      <div class="series-grid">
        {[...series.entries()].map(([name, list]) => (
          <a class="series-card" href={localizedPath(locale, `series/${encodeURIComponent(name)}`)}>
            <span class="series-card__name">{name}</span>
            <span class="series-card__count">{t('common.postsCount', { count: list.length })}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 2rem 0 3rem;
  }
  .hero__image {
    display: inline-block;
    width: 6rem;
    height: 6rem;
    background: var(--color-text);
    mask: url('/logo.png') center / contain no-repeat;
    -webkit-mask: url('/logo.png') center / contain no-repeat;
    margin-bottom: 1.25rem;
  }
  .hero__title { font-size: 1.75rem; margin-bottom: 0.5rem; }
  @media (min-width: 640px) {
    .hero__title { font-size: 2.25rem; }
  }
  .hero__tagline { font-size: 1rem; color: var(--color-text-muted); margin-bottom: 0.75rem; }
  .hero__intro {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--color-text-muted);
    max-width: 36rem;
    margin: 0 auto 1.5rem;
    line-height: 1.7;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .home-section { margin-top: 3rem; }
  .home-section__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }
  .section-title--inline { margin-bottom: 0; padding-bottom: 0; border-bottom: none; }
  .home-section__desc {
    margin: -0.5rem 0 1rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .home-section__more { margin-top: 1.5rem; text-align: center; }

  .kind-badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 0.12rem 0.45rem;
    border-radius: 4px;
  }
  .kind-badge--post { color: var(--color-post-text); background: var(--color-post-bg); }
  .kind-badge--paper {
    color: var(--color-paper-line);
    background: transparent;
    border: 1px solid var(--color-paper-line);
  }

  .paper-mini { list-style: none; padding: 0; margin: 0; }
  .paper-mini__item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-border);
    border-left: 3px solid var(--color-paper-line);
    padding-left: 0.9rem;
  }
  .paper-mini__link { font-weight: 600; font-size: 1rem; }
  .paper-mini__meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }
  .series-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.75rem;
  }
  .series-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color var(--transition);
  }
  .series-card:hover { border-color: var(--color-accent); text-decoration: none; }
  .series-card__name { font-weight: 600; }
  .series-card__count { font-size: 0.8125rem; color: var(--color-text-muted); }
</style>
