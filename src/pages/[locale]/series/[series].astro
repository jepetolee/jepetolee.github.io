---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getSeries, postUrl, slugOf } from '../../../utils/posts';
import { LOCALES } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/ui';

export const getStaticPaths = (async () => {
  const routes = [];
  for (const locale of LOCALES) {
    const series = await getSeries(locale);
    for (const [name, posts] of series.entries()) {
      routes.push({ params: { locale, series: name }, props: { locale, name, posts } });
    }
  }
  return routes;
}) satisfies GetStaticPaths;

const { name, posts, locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout title={`${name} · ${t('series.badge')}`} description={name} narrow={true} locale={locale}>
  <h1 class="page-title">{name} <span class="page-title__tag">{t('series.badge')}</span></h1>
  <p class="page-sub">{t('series.sub', { count: posts.length })}</p>

  <div class="post-list">
    {posts.map((post, i) => (
      <div class="series-entry">
        <span class="series-entry__num">{i + 1}</span>
        <div class="series-entry__card">
          <PostCard
            url={postUrl(locale, slugOf(post))}
            title={post.data.title}
            date={post.data.date}
            tags={post.data.tags}
            description={post.data.description}
            category={post.data.category}
            locale={locale}
          />
        </div>
      </div>
    ))}
  </div>
</BaseLayout>

<style>
  .page-title { font-size: 1.75rem; margin-bottom: 0.25rem; }
  .page-title__tag { font-size: 1rem; color: var(--color-text-muted); font-weight: 400; }
  .page-sub { color: var(--color-text-muted); font-size: 0.9rem; margin: 0 0 1.5rem; }
  .series-entry { display: flex; gap: 0.75rem; align-items: flex-start; }
  .series-entry__num {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    margin-top: 1.25rem;
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .series-entry__card { flex: 1; min-width: 0; }
</style>
