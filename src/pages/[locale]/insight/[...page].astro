---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPublishedPosts, postUrl, slugOf, type Post } from '../../../utils/posts';
import { SITE } from '../../../config';
import { LOCALES, type Locale } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/ui';

export const getStaticPaths = (async ({ paginate }) => {
  const routes = [];
  for (const locale of LOCALES) {
    const posts = await getPublishedPosts(locale);
    routes.push(
      ...paginate(posts, {
        params: { locale },
        props: { locale },
        pageSize: SITE.postsPerPage,
      }),
    );
  }
  return routes;
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
  locale: Locale;
}
const { page, locale } = Astro.props as Props;
const t = useTranslations(locale);
---

<BaseLayout title={t('insight.title')} description={t('insight.subtitle', { count: page.total })} narrow={true} locale={locale}>
  <h1 class="page-title">{t('insight.title')}</h1>
  <p class="page-sub">{t('insight.subtitle', { count: page.total })}</p>

  <div class="post-list">
    {page.data.map((post) => (
      <PostCard
        url={postUrl(locale, slugOf(post))}
        title={post.data.title}
        date={post.data.date}
        tags={post.data.tags}
        description={post.data.description}
        category={post.data.category}
        locale={locale}
      />
    ))}
  </div>

  <nav class="pagination" aria-label="Pagination">
    {page.url.prev ? (
      <a class="pagination__item" href={page.url.prev}>{t('pagination.newer')}</a>
    ) : (
      <span class="pagination__item pagination__item--disabled">{t('pagination.newer')}</span>
    )}
    <span class="pagination__count">{page.currentPage} / {page.lastPage}</span>
    {page.url.next ? (
      <a class="pagination__item" href={page.url.next}>{t('pagination.older')}</a>
    ) : (
      <span class="pagination__item pagination__item--disabled">{t('pagination.older')}</span>
    )}
  </nav>
</BaseLayout>

<style>
  .page-title { font-size: 1.75rem; margin-bottom: 0.25rem; }
  .page-sub { color: var(--color-text-muted); font-size: 0.9rem; margin: 0 0 1.5rem; }
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
  }
  .pagination__item {
    padding: 0.6rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
  }
  .pagination__item:hover { border-color: var(--color-accent); color: var(--color-accent); text-decoration: none; }
  .pagination__item--disabled { opacity: 0.4; pointer-events: none; }
  .pagination__count { color: var(--color-text-muted); }
</style>
