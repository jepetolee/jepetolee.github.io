---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

export const getStaticPaths = (() =>
  LOCALES.map((locale) => ({ params: { locale }, props: { locale } }))) satisfies GetStaticPaths;

const { locale } = Astro.props;
const t = useTranslations(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pagefindTranslations = {
  placeholder: t('search.placeholder'),
  zero_results: t('search.zeroResults'),
};
const searchHint = t('search.hint');
---

<BaseLayout title={t('search.title')} description={t('search.sub')} narrow={true} locale={locale}>
  <h1 class="page-title">{t('search.title')}</h1>
  <p class="page-sub">{t('search.sub')}</p>

  <div id="search"></div>

  <link rel="stylesheet" href={`${base}/pagefind/pagefind-ui.css`} />
  <script is:inline src={`${base}/pagefind/pagefind-ui.js`}></script>
  <script is:inline define:vars={{ pagefindTranslations, searchHint }}>
    window.addEventListener('DOMContentLoaded', () => {
      if (typeof PagefindUI !== 'undefined') {
        new PagefindUI({
          element: '#search',
          showSubResults: true,
          showImages: false,
          translations: pagefindTranslations,
        });
      } else {
        document.getElementById('search').innerHTML =
          '<p class="search-hint">' + searchHint + '</p>';
      }
    });
  </script>
</BaseLayout>

<style>
  .page-title { font-size: 1.75rem; margin-bottom: 0.25rem; }
  .page-sub { color: var(--color-text-muted); font-size: 0.9rem; margin: 0 0 1.5rem; }
  :global(.search-hint) { color: var(--color-text-muted); font-size: 0.9rem; }
  #search {
    --pagefind-ui-primary: var(--color-accent);
    --pagefind-ui-text: var(--color-text);
    --pagefind-ui-background: var(--color-surface);
    --pagefind-ui-border: var(--color-border);
    --pagefind-ui-font: var(--font-sans);
  }
</style>
