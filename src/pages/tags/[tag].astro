---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getAllTags, postUrl } from '../../utils/posts';

export const getStaticPaths = (async () => {
  const tags = await getAllTags();
  const posts = await getPublishedPosts();
  return tags.map(({ tag }) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`${tag} 태그가 달린 글`} narrow={true}>
  <h1 class="page-title">#{tag}</h1>
  <p class="page-sub">{posts.length}편의 글</p>

  <div class="post-list">
    {posts.map((post) => (
      <PostCard
        url={postUrl(post.id)}
        title={post.data.title}
        date={post.data.date}
        tags={post.data.tags}
        description={post.data.description}
        category={post.data.category}
      />
    ))}
  </div>
</BaseLayout>

<style>
  .page-title { font-size: 1.75rem; margin-bottom: 0.25rem; }
  .page-sub { color: var(--color-text-muted); font-size: 0.9rem; margin: 0 0 1.5rem; }
</style>
