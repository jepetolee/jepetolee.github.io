---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getPapers, getAllTags, postUrl, paperUrl } from '../../utils/posts';

export const getStaticPaths = (async () => {
  const tags = await getAllTags();
  const posts = await getPublishedPosts();
  const papers = await getPapers();
  return tags.map(({ tag }) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((p) => p.data.tags.includes(tag)),
      papers: papers.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}) satisfies GetStaticPaths;

const { tag, posts, papers } = Astro.props;
const total = posts.length + papers.length;
---

<BaseLayout title={`#${tag}`} description={`${tag} 태그가 달린 글과 논문 리뷰`} narrow={true}>
  <h1 class="page-title">#{tag}</h1>
  <p class="page-sub">블로그 {posts.length}편 · 논문 리뷰 {papers.length}편 (총 {total}편)</p>

  {posts.length > 0 && (
    <section class="tag-group">
      <div class="tag-group__head">
        <span class="kind-badge kind-badge--post">POST</span>
        <h2 class="tag-group__title">블로그 글</h2>
      </div>
      <div class="post-list">
        {posts.map((post) => (
          <PostCard
            kind="post"
            url={postUrl(post.id)}
            title={post.data.title}
            date={post.data.date}
            tags={post.data.tags}
            description={post.data.description}
            category={post.data.category}
          />
        ))}
      </div>
    </section>
  )}

  {papers.length > 0 && (
    <section class="tag-group">
      <div class="tag-group__head">
        <span class="kind-badge kind-badge--paper">PAPER</span>
        <h2 class="tag-group__title">논문 리뷰</h2>
      </div>
      <div class="post-list">
        {papers.map((paper) => (
          <PostCard
            kind="paper"
            url={paperUrl(paper.id)}
            title={paper.data.title}
            date={paper.data.date}
            tags={paper.data.tags}
            description={paper.data.description}
            category={[paper.data.category, paper.data.subcategory].filter(Boolean).join(' · ')}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .page-title { font-size: 1.75rem; margin-bottom: 0.25rem; }
  .page-sub { color: var(--color-text-muted); font-size: 0.9rem; margin: 0 0 2rem; }
  .tag-group { margin-bottom: 2.5rem; }
  .tag-group__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }
  .tag-group__title { font-size: 1.15rem; margin: 0; }
  .kind-badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 0.12rem 0.45rem;
    border-radius: 4px;
  }
  .kind-badge--post { color: var(--color-post-text); background: var(--color-post-bg); }
  .kind-badge--paper {
    color: var(--color-paper-line);
    background: transparent;
    border: 1px solid var(--color-paper-line);
  }
</style>
