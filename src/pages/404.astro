---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_LOCALE } from '../i18n/config';
import { localizedPath } from '../i18n/utils';
import { useTranslations } from '../i18n/ui';

const t = useTranslations(DEFAULT_LOCALE);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={t('error.title')} narrow={true} locale={DEFAULT_LOCALE}>
  <div class="error-page">
    <p class="error-page__code">404</p>
    <h1>{t('error.title')}</h1>
    <p class="error-page__lead">{t('error.lead')}</p>
    <div class="error-page__actions">
      <a class="btn" href={`${base}/`}>{t('error.home')}</a>
      <a class="btn btn--outline" href={localizedPath(DEFAULT_LOCALE, '/insight/')}>{t('error.posts')}</a>
    </div>
  </div>
</BaseLayout>

<style>
  .error-page { text-align: center; padding: 3rem 0; }
  .error-page__code {
    font-size: 4rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
    margin: 0 0 0.5rem;
  }
  .error-page__lead { color: var(--color-text-muted); margin-bottom: 1.5rem; }
  .error-page__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
</style>
